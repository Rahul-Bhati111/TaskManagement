@page
@model TaskManagement.Web.Pages.CreateModel

@{
    ViewData["Title"] = "Create Task";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Create New Task</h2>
        <p class="text-muted">Enter the task details below.</p>
    </div>

    <div class="card">
        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label">
                        Task Title *
                    </label>

                    <input asp-for="Input.Title"
                           class="form-control"
                           placeholder="Enter task title" />

                    <span asp-validation-for="Input.Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter task description">
                    </textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.DueDate"
                           class="form-label">
                        Due Date *
                    </label>

                    <input asp-for="Input.DueDate"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control" />

                    <span asp-validation-for="Input.DueDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.PriorityId"
                           class="form-label">
                        Priority *
                    </label>

                    <select asp-for="Input.PriorityId"
                            class="form-select">

                        <option value="">Select Priority</option>

                        @foreach (var priority in Model.Priorities)
                        {
                            <option value="@priority.PriorityId">
                                @priority.PriorityName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Input.PriorityId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.AssignedUserId"
                           class="form-label">
                        Assigned User
                    </label>

                    <select asp-for="Input.AssignedUserId"
                            class="form-select">

                        <option value="">Unassigned</option>

                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.UserId">
                                @user.FullName
                            </option>
                        }

                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Task
                </button>

                <a asp-page="/TaskList"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}